rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerEmail() {
      return signedIn() && request.auth.token.email == 'rohanvasoya2013@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function active() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().data.status == 'active';
    }

    function roleIs(role) {
      return active() && profile().data.role == role;
    }

    function admin() {
      return ownerEmail() || roleIs('admin');
    }

    function anyRole(roles) {
      return active() && profile().data.role in roles;
    }

    function billHasPayment() {
      return resource.data.get('amountPaid', 0) > 0
        || resource.data.get('paymentStatus', 'Unpaid') in ['Paid', 'Partial', 'Partially Paid'];
    }

    function approvalRequired() {
      return exists(/databases/$(database)/documents/settings/billWorkflow)
        && get(/databases/$(database)/documents/settings/billWorkflow).data.printPolicy == 'approved_only';
    }

    function billApprovedForRelease() {
      return !approvalRequired()
        || resource.data.get('workflowStatus', 'draft') in ['approved', 'locked']
        || resource.data.get('locked', false) == true;
    }

    function openBill() {
      return resource.data.get('locked', false) != true
        && resource.data.get('workflowStatus', 'draft') != 'locked';
    }

    function billEditor() {
      return anyRole(['admin', 'manager', 'biller']) && openBill()
        && resource.data.get('deleted', false) == false
        && request.resource.data.get('locked', false) == resource.data.get('locked', false)
        && request.resource.data.get('workflowStatus', 'draft') == resource.data.get('workflowStatus', 'draft')
        && !(request.resource.data.get('deleted', false) == true && billHasPayment());
    }

    // Archived bills are accounting evidence. Only an Admin can restore one,
    // and the restore operation may change only its archive flags.
    function billRestorer() {
      return admin()
        && resource.data.get('deleted', false) == true
        && request.resource.data.get('deleted', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleted', 'deletedAt']);
    }

    function billApprover() {
      return anyRole(['admin', 'manager']) && openBill()
        && resource.data.get('workflowStatus', 'draft') == 'draft'
        && request.resource.data.get('workflowStatus', 'draft') == 'approved'
        && request.resource.data.get('locked', false) == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['workflowStatus', 'approvedAt', 'approvedBy', 'lastUpdatedAt']);
    }

    function billLocker() {
      return admin() && openBill()
        && resource.data.get('workflowStatus', 'draft') == 'approved'
        && request.resource.data.get('workflowStatus', 'draft') == 'locked'
        && request.resource.data.get('locked', false) == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['workflowStatus', 'locked', 'lockedAt', 'lockedBy', 'lastUpdatedAt']);
    }

    function billPaymentUpdater() {
      return anyRole(['admin', 'accountant'])
        && billApprovedForRelease()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['amountPaid', 'amountDue', 'paymentStatus', 'lastUpdatedAt']);
    }

    // The configured owner can bootstrap only their own admin record. Every
    // other new account may create only a pending viewer request for itself.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if ownerEmail() && request.auth.uid == uid
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.status == 'pending'
              && request.resource.data.role == 'viewer');
      // A user may refresh only their own contact/sign-in metadata. Role,
      // status and company scope remain Admin-controlled.
      allow update: if admin()
          || (signedIn() && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['displayName', 'mobileNumber', 'mobileKey', 'providerIds', 'lastSignInAt', 'updatedAt'])
              && (request.resource.data.get('mobileKey', '') == resource.data.get('mobileKey', '')
                || (request.resource.data.get('mobileKey', '').size() == 12
                  && existsAfter(/databases/$(database)/documents/mobileDirectory/$(request.resource.data.mobileKey))
                  && getAfter(/databases/$(database)/documents/mobileDirectory/$(request.resource.data.mobileKey)).data.uid == uid)));
      allow delete: if admin();
    }

    // The document ID is the normalised +91 mobile key. It makes a mobile
    // number globally unique without trusting a browser-only duplicate check.
    match /mobileDirectory/{mobileKey} {
      allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mobileKey == mobileKey
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobileKey == mobileKey;
      allow delete: if signedIn()
          && resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('mobileKey', '') != mobileKey;
      allow read, update: if admin();
    }

    // A customer can open only an unguessable, time-limited shared bill link.
    // Collection listing is never public.
    match /sharedBills/{shareId} {
      allow get: if admin()
        || (resource.data.expiresAt > request.time && resource.data.get('revoked', false) == false);
      allow list: if admin();
      allow create: if anyRole(['admin', 'manager', 'biller'])
        && (!approvalRequired() || request.resource.data.bill.workflowStatus in ['approved', 'locked']);
      allow update, delete: if admin();
    }

    // Audit evidence is append-only. Only an Admin may review it; each
    // creator record must identify the same Firebase user making the request.
    match /auditLogs/{auditId} {
      allow read: if admin();
      allow create: if active() && request.resource.data.actor.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /bills/{billId} {
      allow read: if active();
      allow create: if anyRole(['admin', 'manager', 'biller'])
        && request.resource.data.get('locked', false) == false
        && request.resource.data.get('workflowStatus', 'draft') == 'draft';
      allow update: if billEditor() || billRestorer() || billApprover() || billLocker() || billPaymentUpdater();
      allow delete: if admin() && !billHasPayment();
    }

    match /orders/{orderId} {
      allow read: if active();
      allow create, update: if anyRole(['admin', 'manager', 'biller']);
      allow delete: if admin();
    }

    match /parties/{partyId} {
      allow read: if active();
      allow create, update: if anyRole(['admin', 'manager', 'biller']);
      allow delete: if admin();
    }

    match /{collection}/{document} {
      allow read: if collection != 'auditLogs' && active();
      allow create, update: if collection in ['products', 'varieties', 'customers', 'counters', 'brokers']
          && anyRole(['admin', 'manager', 'biller']);
      allow create, update, delete: if collection in ['payments', 'broker_payments']
          && anyRole(['admin', 'accountant']);
      allow write: if collection == 'settings' && admin();
      allow delete: if collection in ['products', 'varieties', 'customers', 'counters', 'brokers'] && admin();
    }
  }
}
